# Required — voice agents + D-ID lip-sync TTS
ELEVENLABS_API_KEY=

# Required — animated avatar streams
D_ID_API_KEY=

# Local dev — whiteboard illustrations (direct OpenAI, not gateway)
OPENAI_API_KEY=

# Production on Vercel — whiteboard uses AI Gateway + Gemini automatically.
# Enable AI Gateway in project settings, then either:
#   - Deploy (VERCEL_OIDC_TOKEN is injected), or
#   - Run: vercel env pull .env.local
# Optional static key (CI / non-OIDC):
# AI_GATEWAY_API_KEY=

# Optional — direct Gemini if you skip OpenAI in dev (bypasses gateway)
# GEMINI_API_KEY=

# Optional — override ElevenLabs agent LLM (default: gemini-2.0-flash)
# ELEVENLABS_LLM_MODEL=gemini-2.0-flash
